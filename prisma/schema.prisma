// Prisma schema for the AI Room Sketch-to-3D Render app.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth (NextAuth / Auth.js) ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String? // null for OAuth-only accounts
  consentAt     DateTime? // when the user checked "I agree to the Privacy Policy and Terms of Use"

  plan             String    @default("free") // "free" | "pro"
  stripeCustomerId String?   @unique
  stripeSubId      String?   @unique
  planRenewsAt     DateTime?
  planCanceledAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts      Account[]
  sessions      Session[]
  sketches      Sketch[]
  renders       Render[]
  usageEvents   UsageEvent[]
  emailLogs     EmailLog[]
  passwordResets PasswordResetToken[]
  verifications  VerificationToken[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id        String   @id @default(cuid())
  identifier String
  token      String  @unique
  expires    DateTime
  userId     String?
  user       User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expires   DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Core product domain ---

model Sketch {
  id           String   @id @default(cuid())
  userId       String
  imageDataUrl String // pre-processed sketch photo (data URL), sent to the image model as a reference
  roomType     String?
  description  String? // the user's "look and feel" brief
  viewStyle    String? // "isometric" | "perspective"
  createdAt    DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  renders Render[]

  @@index([userId])
}

model Render {
  id           String  @id @default(cuid())
  userId       String
  sketchId     String
  status       String  @default("pending") // pending | processing | complete | failed
  imageData    String? // generated render, base64 (no data: prefix)
  imageMime    String? // e.g. image/jpeg
  thumbnailUrl String? // small JPEG data URL for the dashboard grid
  prompt       String? // the exact prompt sent to the image model
  model        String? // image model that produced it
  source       String  @default("openrouter") // "openrouter" | "demo"
  errorMessage String?
  // Unguessable token for the public share link / image URL. Defaulted in the
  // database so rows created before this column existed are backfilled.
  shareToken   String  @unique @default(dbgenerated("gen_random_uuid()::text"))

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sketch    Sketch       @relation(fields: [sketchId], references: [id], onDelete: Cascade)
  usage     UsageEvent[]
  emailLogs EmailLog[]

  @@index([userId])
}

model UsageEvent {
  id          String   @id @default(cuid())
  userId      String
  renderId    String?
  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  costUsd      Float   @default(0)
  createdAt    DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  render Render? @relation(fields: [renderId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model EmailLog {
  id         String   @id @default(cuid())
  userId     String
  renderId   String?
  toEmail    String
  message    String?
  status     String   @default("sent") // "sent" | "demo" | "failed"
  createdAt  DateTime @default(now())

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  render Render? @relation(fields: [renderId], references: [id], onDelete: SetNull)

  @@index([userId])
}
